{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Level0L",
  "scopeName": "source.level0l",
  "patterns": [
    { "include": "#comment" },
    { "include": "#entity-header" },
    { "include": "#member" },
    { "include": "#tag" },
    { "include": "#invalid" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*(#.*)$",
      "captures": {
        "1": { "name": "comment.line.number-sign.level0l" }
      }
    },
    "entity-header": {
      "comment": "[!][-]type [id[.version]] [: lat, lon] [# comment]",
      "match": "^(!)?(-)?(node|way|relation|changeset)(?:\\s+(-[0-9]+|[0-9]+)(?:(\\.)([0-9]+))?)?(?:\\s*(:)\\s*(-?[0-9]{1,2}(?:\\.[0-9]+)?)\\s*(,)\\s*(-?[0-9]{1,3}(?:\\.[0-9]+)?))?\\s*(#.*)?$",
      "captures": {
        "1": { "name": "invalid.illegal.conflict.level0l" },
        "2": { "name": "keyword.operator.delete.level0l" },
        "3": { "name": "keyword.control.entity.level0l" },
        "4": {
          "patterns": [
            { "match": "-[0-9]+", "name": "constant.numeric.id.new.level0l" },
            { "match": "[0-9]+", "name": "constant.numeric.id.level0l" }
          ]
        },
        "5": { "name": "punctuation.separator.version.level0l" },
        "6": { "name": "constant.numeric.version.level0l" },
        "7": { "name": "punctuation.separator.coordinates.level0l" },
        "8": { "name": "constant.numeric.latitude.level0l" },
        "9": { "name": "punctuation.separator.coordinates.level0l" },
        "10": { "name": "constant.numeric.longitude.level0l" },
        "11": { "name": "comment.line.number-sign.level0l" }
      }
    },
    "member": {
      "comment": "nd|wy|rel id [role]",
      "match": "^\\s*(nd|wy|rel)\\s+(-[0-9]+|[0-9]+)(?:\\s+(.+?))?\\s*$",
      "captures": {
        "1": { "name": "storage.type.member.level0l" },
        "2": {
          "patterns": [
            { "match": "-[0-9]+", "name": "constant.numeric.id.new.level0l" },
            { "match": "[0-9]+", "name": "constant.numeric.id.level0l" }
          ]
        },
        "3": { "name": "string.unquoted.role.level0l" }
      }
    },
    "tag": {
      "comment": "key = value; '\\=' inside a key is an escaped equals sign",
      "match": "^\\s*((?:[^=\\\\]|\\\\.)*?)\\s*(=)\\s*(.*?)\\s*$",
      "captures": {
        "1": {
          "name": "entity.name.tag.key.level0l",
          "patterns": [
            { "match": "\\\\=", "name": "constant.character.escape.level0l" }
          ]
        },
        "2": { "name": "keyword.operator.assignment.level0l" },
        "3": { "name": "string.unquoted.value.level0l" }
      }
    },
    "invalid": {
      "match": "^\\s*\\S.*$",
      "name": "invalid.illegal.unparsed.level0l"
    }
  }
}
