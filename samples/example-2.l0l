way 430314052 #вулиця Сергія Довганя (17 точок)
  highway = residential
  name = вулиця Сергія Довганя
  name:etymology = Сергій Олексійович Довгань
  name:etymology:description = Молодший сержант Сергій Довгань (1985–2023), етнолог, музейник. Загинув у бою біля Садків. Боєць ССО. Посмертно нагороджений орденом «За мужність» III ступеня.
  name:etymology:description:en = Junior Sergeant Serhii Dovhan (1985–2023), ethnologist, museum curator. Killed in battle near Sadky. Special Forces soldier. Posthumously awarded the Order for Courage, 3rd class.
  name:uk = вулиця Сергія Довганя
  name:uk-Latn = vulytsia Serhiia Dovhania
