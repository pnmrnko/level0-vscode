{
  "name": "level0l",
  "displayName": "Level0L",
  "description": "Edit OpenStreetMap as text: Level0L language support with taginfo, download from OSM and Overpass, conflict check and changeset upload",
  "version": "0.2.0",
  "publisher": "pnmrnko",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pnmrnko/level0-vscode"
  },
  "homepage": "https://github.com/pnmrnko/level0-vscode#readme",
  "bugs": {
    "url": "https://github.com/pnmrnko/level0-vscode/issues"
  },
  "galleryBanner": {
    "color": "#1f5f3b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "openstreetmap",
    "osm",
    "level0",
    "level0l",
    "taginfo",
    "overpass"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "level0l",
        "aliases": [
          "Level0L",
          "level0l"
        ],
        "extensions": [
          ".l0l",
          ".level0"
        ],
        "firstLine": "^\\s*[!-]*(node|way|relation|changeset)\\b",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "overpassql",
        "aliases": [
          "Overpass QL"
        ],
        "extensions": [
          ".overpassql"
        ]
      }
    ],
    "grammars": [
      {
        "language": "level0l",
        "scopeName": "source.level0l",
        "path": "./syntaxes/level0l.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Level0L",
      "properties": {
        "level0l.osmBaseUrl": {
          "type": "string",
          "default": "https://www.openstreetmap.org",
          "description": "Base URL of the OSM website used for object and map links."
        },
        "level0l.wikiBaseUrl": {
          "type": "string",
          "default": "https://wiki.openstreetmap.org/wiki",
          "description": "Base URL of the OSM wiki used for tag key/value links."
        },
        "level0l.tagLinks": {
          "type": "boolean",
          "default": true,
          "description": "Turn tag keys and values into links to their OSM wiki pages."
        },
        "level0l.taginfo.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show taginfo statistics and wiki descriptions when hovering tag keys and values."
        },
        "level0l.taginfo.url": {
          "type": "string",
          "default": "https://taginfo.openstreetmap.org",
          "description": "Base URL of the taginfo instance to query."
        },
        "level0l.taginfo.lang": {
          "type": "string",
          "default": "",
          "description": "Language code for wiki descriptions in hovers (e.g. \"uk\"). Empty means the VS Code display language."
        },
        "level0l.taginfo.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Warn about keys and values that are unused in OSM or marked deprecated on the wiki, using taginfo."
        },
        "level0l.osmApiUrl": {
          "type": "string",
          "default": "https://api.openstreetmap.org/api/0.6/",
          "description": "Base URL of the OSM API 0.6 used for downloading and uploading. Use https://api06.dev.openstreetmap.org/api/0.6/ for the development server."
        },
        "level0l.oauth.clientId": {
          "type": "string",
          "default": "",
          "description": "OAuth 2 client id of a public application registered on the OSM site in use. Empty means the built-in id for openstreetmap.org or the development server."
        },
        "level0l.overpassUrl": {
          "type": "string",
          "default": "https://overpass-api.de/api/interpreter",
          "description": "Overpass API endpoint used by \"Run Overpass query\"."
        },
        "level0l.map.tileUrl": {
          "type": "string",
          "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
          "description": "Tile URL template of the map panel. Alternatives: https://tile.openstreetmap.org.ua/styles/osm-bright/{z}/{x}/{y}.png (Ukrainian community, also positron-gl-style and dark-matter-gl-style), https://tile.openstreetmap.de/{z}/{x}/{y}.png, https://tile.openstreetmap.fr/hot/{z}/{x}/{y}.png."
        },
        "level0l.map.attribution": {
          "type": "string",
          "default": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
          "description": "Attribution shown on the map, HTML allowed."
        },
        "level0l.map.maxZoom": {
          "type": "integer",
          "default": 19,
          "description": "Highest zoom level the tile server offers."
        },
        "level0l.maxObjects": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "description": "Maximum number of objects a single download adds to the document."
        }
      }
    },
    "configurationDefaults": {
      "[level0l]": {
        "editor.wordWrap": "on",
        "editor.guides.indentation": false,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "commands": [
      {
        "command": "level0l.stripMemberComments",
        "title": "Strip member comments (JOSM comfort0)",
        "category": "Level0L"
      },
      {
        "command": "level0l.download",
        "title": "Download from OSM",
        "category": "Level0L"
      },
      {
        "command": "level0l.runOverpass",
        "title": "Run Overpass query",
        "category": "Level0L"
      },
      {
        "command": "level0l.checkConflicts",
        "title": "Check for conflicts with the server",
        "category": "Level0L"
      },
      {
        "command": "level0l.showOsc",
        "title": "Show osmChange",
        "category": "Level0L"
      },
      {
        "command": "level0l.exportOsm",
        "title": "Export as OSM XML",
        "category": "Level0L"
      },
      {
        "command": "level0l.showMap",
        "title": "Show map",
        "category": "Level0L",
        "icon": "$(map)"
      },
      {
        "command": "level0l.revert",
        "title": "Revert object to the server version",
        "category": "Level0L"
      },
      {
        "command": "level0l.upload",
        "title": "Upload changeset",
        "category": "Level0L"
      },
      {
        "command": "level0l.login",
        "title": "Log in to OSM",
        "category": "Level0L"
      },
      {
        "command": "level0l.logout",
        "title": "Log out of OSM",
        "category": "Level0L"
      },
      {
        "command": "level0l.account",
        "title": "OSM account",
        "category": "Level0L"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "level0l.showMap",
          "when": "editorLangId == level0l",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "level0l.stripMemberComments",
          "when": "editorLangId == level0l"
        },
        {
          "command": "level0l.checkConflicts",
          "when": "editorLangId == level0l"
        },
        {
          "command": "level0l.showOsc",
          "when": "editorLangId == level0l"
        },
        {
          "command": "level0l.upload",
          "when": "editorLangId == level0l"
        },
        {
          "command": "level0l.exportOsm",
          "when": "editorLangId == level0l"
        },
        {
          "command": "level0l.revert",
          "when": "editorLangId == level0l"
        },
        {
          "command": "level0l.account",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test 'out/test/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
